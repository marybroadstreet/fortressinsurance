{
  "name": "fortress-insurance-solutions",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Fortress Insurance Solutions website: React 19, prerendered, deployed on Cloudflare Workers.",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "images": "node scripts/optimize-images.mjs",
    "fonts": "node scripts/subset-fonts.mjs",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/libre-caslon-text": "5.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "vite": "8.3.8",
    "wrangler": "4.167.0"
  }
}
